{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * {$SITE_ROOT:public}
	encode zstd gzip
	header Cache-Control "public, max-age=0, must-revalidate"
	header X-Content-Type-Options "nosniff"
	redir /food.html /menu.html 301
	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
	log {
		output stdout
		format json
	}
}
